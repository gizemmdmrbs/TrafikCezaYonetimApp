@using TrafikCezaYonetimApp.Models.Entities
@model List<TrafikCezaYonetimApp.Models.Entities.Penalty>
@{
    ViewData["Title"] = "Cezalar";
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Cezalar</h3>
    @if (User.IsInRole("Personel"))
    {
        <a asp-action="Create" class="btn btn-primary">Yeni Ceza</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Plaka</th>
            <th>Açıklama</th>
            <th>Tutar</th>
            <th>Ceza Tarihi</th>
            <th>Durum</th>
            <th>Giren</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Vehicle.Plate</td>
                <td>@p.Description</td>
                <td>@p.Amount.ToString("N2") TL</td>
                <td>@p.PenaltyDate.ToString("dd.MM.yyyy")</td>
                <td>@Html.DisplayFor(m => p.Status)</td>
                <td>@p.CreatedByUser.UserName</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Geçmiş</a>
                    @if (User.IsInRole("Personel") && p.CreatedByUserId == currentUserId && p.Status == PenaltyStatus.YoneticiOnayi)
                    {
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Bu ceza silinsin mi?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">Kayıtlı ceza yok.</td></tr>
        }
    </tbody>
</table>