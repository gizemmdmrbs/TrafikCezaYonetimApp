@model List<TrafikCezaYonetimApp.Models.Entities.Penalty>
@{
    ViewData["Title"] = "Cezalar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Cezalar</h3>
    @if (User.IsInRole("Personel"))
    {
        <a asp-action="Create" class="btn btn-primary">Yeni Ceza</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Plaka</th>
            <th>Açıklama</th>
            <th>Tutar</th>
            <th>Ceza Tarihi</th>
            <th>Durum</th>
            <th>Giren</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Vehicle.Plate</td>
                <td>@p.Description</td>
                <td>@p.Amount.ToString("N2") TL</td>
                <td>@p.PenaltyDate.ToString("dd.MM.yyyy")</td>
                <td>@Html.DisplayFor(m => p.Status)</td>
                <td>@p.CreatedByUser.UserName</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">Kayıtlı ceza yok.</td></tr>
        }
    </tbody>
</table>