@using TrafikCezaYonetimApp.Models.Entities
@model TrafikCezaYonetimApp.Models.Entities.Penalty
@{
    ViewData["Title"] = "Ceza Detayı";

    string StatusBadge(PenaltyStatus s) => s switch
    {
        PenaltyStatus.Tamamlandi => "bg-success",
        PenaltyStatus.Reddedildi => "bg-danger",
        PenaltyStatus.FinansOnayi => "bg-info text-dark",
        _ => "bg-warning text-dark"
    };
}

<div class="page-header">
    <h3 class="page-title">Ceza Detayı</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
</div>

<div class="form-card mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="info-label">Plaka</div>
            <div class="info-value">@Model.Vehicle.Plate (@Model.Vehicle.Brand @Model.Vehicle.Model)</div>
        </div>
        <div class="col-md-4">
            <div class="info-label">Tutar</div>
            <div class="info-value">@Model.Amount.ToString("N2") TL</div>
        </div>
        <div class="col-md-4">
            <div class="info-label">Ceza Tarihi</div>
            <div class="info-value">@Model.PenaltyDate.ToString("dd.MM.yyyy")</div>
        </div>
        <div class="col-md-4">
            <div class="info-label">Giren</div>
            <div class="info-value">@Model.CreatedByUser.UserName</div>
        </div>
        <div class="col-md-4">
            <div class="info-label">Durum</div>
            <span class="badge rounded-pill status-badge @StatusBadge(Model.Status)">@Html.DisplayFor(m => m.Status)</span>
        </div>
        <div class="col-12">
            <div class="info-label">Açıklama</div>
            <div class="info-value">@Model.Description</div>
        </div>
    </div>

    @if (Model.Status == PenaltyStatus.Reddedildi && !string.IsNullOrEmpty(Model.RejectReason))
    {
        <div class="alert alert-danger mt-3 mb-0">
            <strong>Ret nedeni:</strong> @Model.RejectReason
        </div>
    }
</div>

<h5 class="page-title mb-3" style="font-size:1.1rem">Onay Geçmişi</h5>

<div class="card-table">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Kullanıcı</th>
                <th>İşlem</th>
                <th>Önceki Durum</th>
                <th>Yeni Durum</th>
                <th>Açıklama</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model.History.OrderBy(x => x.CreatedAt))
            {
                <tr>
                    <td>@h.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@h.User.UserName</td>
                    <td>@Html.DisplayFor(m => h.ActionType)</td>
                    <td>@Html.DisplayFor(m => h.FromStatus)</td>
                    <td>@Html.DisplayFor(m => h.ToStatus)</td>
                    <td>@h.Note</td>
                </tr>
            }
            @if (!Model.History.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Kayıtlı işlem yok.</td>
                </tr>
            }
        </tbody>
    </table>
</div>