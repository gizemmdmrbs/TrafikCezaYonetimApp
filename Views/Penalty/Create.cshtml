@model TrafikCezaYonetimApp.Models.ViewModels.PenaltyCreateViewModel
@{
    ViewData["Title"] = "Yeni Ceza";
}

<div class="page-header">
    <h3 class="page-title">Yeni Ceza</h3>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="form-card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="VehicleId" class="form-label"></label>
                    <select asp-for="VehicleId" class="form-select" asp-items="Model.Vehicles">
                        <option value="">Seçiniz...</option>
                    </select>
                    <span asp-validation-for="VehicleId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="PenaltyDate" class="form-label"></label>
                        <input asp-for="PenaltyDate" class="form-control" type="date" />
                        <span asp-validation-for="PenaltyDate" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}