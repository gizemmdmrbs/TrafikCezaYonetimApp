<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrafikCezaYonetimApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrafikCezaYonetimApp.styles.css" asp-append-version="true" />
    <style>
        .main-nav {
            background: linear-gradient(90deg, #0d47a1, #1976d2);
        }

        .main-nav .nav-link {
            color: #ffffff;
            border: 2px solid transparent;
            border-radius: 8px;
            padding: 6px 16px;
            margin-right: 6px;
            transition: all 0.2s;
        }

        .main-nav .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.4);
        }

        .main-nav .nav-link.active-link {
            border-color: #ffffff;
            background-color: rgba(255, 255, 255, 0.2);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        }
        <nav class="navbar navbar-expand-sm navbar-dark main-nav shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">TrafikCezaYonetimApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Vehicle" ? "active-link" : "")"
                                   asp-controller="Vehicle" asp-action="Index">Araçlar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Penalty" ? "active-link" : "")"
                                   asp-controller="Penalty" asp-action="Index">Cezalar</a>
                            </li>
                            @if (User.IsInRole("Yonetici") || User.IsInRole("Finans"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Approval" ? "active-link" : "")"
                                       asp-controller="Approval" asp-action="Index">Onay Bekleyenler</a>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center">
                            <span class="text-white me-3">@User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Çıkış</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TrafikCezaYonetimApp
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>