@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="form-card text-center mx-auto mt-5" style="max-width:520px">
    <h3 class="text-danger">Bir sorun oluştu</h3>
    <p class="text-muted">@ViewBag.Message</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Hata kodu: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfaya Dön</a>
</div>