@model List<TrafikCezaYonetimApp.Models.Entities.Vehicle>

@{
     ViewData["Title"] = "Araçlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Araçlar</h3>
    <a asp-action="Create" class="btn btn-primary">Yeni Araç</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Plaka</th>
            <th>Araç Tipi</th>
            <th>Marka</th>
            <th>Model</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Plate</td>
                <td>@Html.DisplayFor(m => v.VehicleType)</td>
                <td>@v.Brand</td>
                <td>@v.Model</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-warning">Düzenle</a>

                    <form asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bu aracı silmek istediğine emin misin?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">Kayıtlı araç yok.</td></tr>
        }

    </tbody>

</table>