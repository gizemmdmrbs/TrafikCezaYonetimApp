@model List<TrafikCezaYonetimApp.Models.Entities.Vehicle>
@{
    ViewData["Title"] = "Araçlar";
}

<div class="page-header">
    <h3 class="page-title">Araçlar</h3>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Araç</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card-table">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Plaka</th>
                <th>Araç Tipi</th>
                <th>Marka</th>
                <th>Model</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td><strong>@v.Plate</strong></td>
                    <td><span class="badge rounded-pill bg-light text-dark border">@Html.DisplayFor(m => v.VehicleType)</span></td>
                    <td>@v.Brand</td>
                    <td>@v.Model</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Bu araç silinsin mi?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">Kayıtlı araç yok.</td>
                </tr>
            }
        </tbody>
    </table>
</div>