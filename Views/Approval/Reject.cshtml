@model TrafikCezaYonetimApp.Models.ViewModels.PenaltyRejectViewModel
@{
    ViewData["Title"] = "Ceza Reddet";
}

<div class="page-header">
    <h3 class="page-title">Ceza Reddet</h3>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="form-card">
            <div class="alert alert-secondary">@ViewBag.Info</div>

            <form asp-action="Reject" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Reason" class="form-label"></label>
                    <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Reason" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-danger">Reddet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}