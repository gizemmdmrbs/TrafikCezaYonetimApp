@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="home-hero">
	<h3 class="mb-1">Hoş geldiniz, @User.Identity?.Name</h3>
	<div>Rolünüz: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
</div>
<div class="row g-3">
	<div class="col-md-4">
		<a class="home-card" asp-controller="Vehicle" asp-action="Index">
			<h5>Araçlar</h5>
			<p class="text-muted mb-0">Araçları listeleyin, yeni araç ekleyin veya düzenleyin.</p>
		</a>
	</div>
	<div class="col-md-4">
		<a class="home-card" asp-controller="Penalty" asp-action="Index">
			<h5>Cezalar</h5>
			<p class="text-muted mb-0">Cezaları, durumlarını ve onay geçmişini görüntüleyin.</p>
		</a>
	</div>
    @if (User.IsInRole("Yonetici") || User.IsInRole("Finans"))
    {
        <div class="col-md-4">
		<a class="home-card" asp-controller="Approval" asp-action="Index">
			<h5>Onay Bekleyenler</h5>
			<p class="text-muted mb-0">Onayınızı bekleyen cezaları onaylayın veya reddedin.</p>
		</a>
	</div>
    }
</div>